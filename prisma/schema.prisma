  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([status])
  @@index([reviewStatus])
  @@index([containerId])
  @@map("document_automation_jobs")
}

model IntegrationConnection {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  provider     String
  name         String
  status       String    @default("NotConnected")
  config       Json?
  lastSyncAt   DateTime? @map("last_sync_at")
  lastTestAt   DateTime? @map("last_test_at")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runs         IntegrationRun[]
  errors       IntegrationError[]

  @@unique([orgId, provider])
  @@index([orgId])
  @@index([provider])
  @@map("integration_connections")
}

model IntegrationRun {
  id             String    @id @default(uuid())
  orgId          String    @map("org_id")
  connectionId   String    @map("connection_id")
  status         String    @default("Queued")
  mode           String    @default("Manual")
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  recordsSeen    Int       @default(0) @map("records_seen")
  recordsChanged Int       @default(0) @map("records_changed")
  summary        String?
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  errors       IntegrationError[]

  @@index([orgId])
  @@index([connectionId])
  @@index([status])
  @@map("integration_runs")
}

model IntegrationError {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  connectionId String    @map("connection_id")
  runId        String?   @map("run_id")
  severity     String    @default("Error")
  message      String
  payload      Json?
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  run          IntegrationRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([connectionId])
  @@index([runId])
  @@map("integration_errors")
}

model ExternalReference {
  id         String   @id @default(uuid())
  orgId      String   @map("org_id")
  provider   String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  externalId String   @map("external_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider, entityType, entityId])
  @@index([orgId])
  @@index([provider, externalId])
  @@map("external_references")
}

// ---------------------------------------------------------------------------
// Deep-gaps foundation (DEEP_GAPS_AUDIT.md): item master, feature flags,
// idempotency, approval delegation, DPDP deletion requests.
// ---------------------------------------------------------------------------

// A1 — Product/item master. Free-text `item` strings on containers, stock
// lots, and price lists link here via nullable itemId (backfilled by name).
model Item {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  code        String
  name        String
  variety     String?
  grade       String?
  hsnCode     String?   @map("hsn_code")
  defaultUom  StockUom  @default(Box) @map("default_uom")
  packSpec    String?   @map("pack_spec")
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  containers     Container[]
  stockItems     StockItem[]
  priceListItems PriceListItem[]

  @@unique([orgId, code])
  @@index([orgId, name])
  @@index([orgId, isActive])
  @@map("items")
}

// D3 — org-scoped feature flags / kill switches (includes maintenance_mode).
model FeatureFlag {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  key         String
  enabled     Boolean  @default(false)
  description String?
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@map("feature_flags")
}

// B1 — duplicate-submission guard for money-touching POST routes. The
// unique(org, scope, key) insert inside the request transaction is the guard.
model IdempotencyKey {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  userId         String   @map("user_id")
  scope          String
  key            String
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// E2 — out-of-office approval delegation, checked by approval routes.
model ApprovalDelegation {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  fromUserId  String    @map("from_user_id")
  toUserId    String    @map("to_user_id")
  scope       String    @default("all")
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime  @map("ends_at")
  reason      String?
  revokedAt   DateTime? @map("revoked_at")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, toUserId, endsAt])
  @@index([orgId, fromUserId, endsAt])
  @@map("approval_delegations")
}

// E5 — DPDP Act data-deletion request log with admin fulfillment trail.
model DataDeletionRequest {
  id              String    @id @default(uuid())
  orgId           String    @map("org_id")
  customerId      String?   @map("customer_id")
  subjectName     String    @map("subject_name")
  subjectContact  String?   @map("subject_contact")
  reason          String?
  status          String    @default("Open")
  requestedAt     DateTime  @default(now()) @map("requested_at")
  resolvedById    String?   @map("resolved_by_id")
  resolvedAt      DateTime? @map("resolved_at")
  resolutionNotes String?   @map("resolution_notes")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@map("data_deletion_requests")
}
