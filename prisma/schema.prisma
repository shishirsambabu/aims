// AIMS - Aeden International Management System
// Prisma schema. All tables carry org_id for multi-tenancy (RLS in Supabase
// is a backup; app-level org scoping is primary).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  admin
  gm
  manager
  sales_executive
  warehouse
  clearing_agent
  finance
  viewer
  auditor
}

enum ApprovalStatus {
  Draft
  PendingApproval
  Approved
  Rejected
}

enum ContainerStatus {
  Booked
  InTransit
  AtPort
  CustomsClearance
  Cleared
  InWarehouse
  EmptyReturned
  PartiallySold
  FullySold
}

enum DocumentType {
  BillOfLading
  CommercialInvoice
  PackingList
  BillOfEntry
  CertificateOfOrigin
  PhytosanitaryCertificate
  Insurance
  DeliveryOrder
  Other
}

enum DocumentStatus {
  Pending
  Uploaded
  Verified
  Expired
}

enum PaymentStatus {
  Pending
  Partial
  Paid
}

enum Currency {
  USD
  AED
  INR
}

enum StockMovementKind {
  Receive
  Grade
  Reserve
  Release
  Sell
  Wastage
  Dump
  Adjust
  Sync
}

enum StockUom {
  Box
  Kg
  Pallet
  Punnet
  Container
  Carton
  CasePack
}

enum StockQualityStatus {
  Released
  QualityHold
  Quarantine
  Rejected
}

enum GatePassStatus {
  Picked
  Packed
  Ready
  PartiallyDispatched
  Dispatched
  Cancelled
}

enum CustomerKycStatus {
  Pending
  Approved
  Rejected
}

enum ReceiptMethod {
  Cash
  BankTransfer
  UPI
  Cheque
  Card
  Adjustment
}

enum CustomerReceiptStatus {
  Posted
  Cancelled
}

enum SalesInvoiceStatus {
  Draft
  Issued
  Cancelled
}

enum SalesReturnStatus {
  Draft
  Posted
  Cancelled
}

enum CreditNoteStatus {
  Draft
  Issued
  Cancelled
}

enum ReturnDisposition {
  Restock
  QualityHold
  Dump
  Reject
}

enum BankReconciliationStatus {
  Unmatched
  Matched
  Exception
  Ignored
}

enum JournalEntryStatus {
  Draft
  Posted
  Reversed
}

enum FinancePeriodStatus {
  Open
  Closing
  Closed
  Reopened
}

enum CustomerDisputeStatus {
  Open
  UnderReview
  Approved
  Rejected
  Resolved
}

enum TemperatureBreachSeverity {
  Info
  Warning
  Critical
}

enum TemperatureBreachTaskStatus {
  Open
  Acknowledged
  Resolved
  Escalated
}

enum PriceListStatus {
  Draft
  Published
  Archived
}

enum SalesOrderStatus {
  Draft
  PendingApproval
  Approved
  Rejected
  Cancelled
  PartiallyFulfilled
  Fulfilled
}

enum CrmLeadStatus {
  New
  Qualified
  Converted
  Disqualified
}

enum CrmOpportunityStage {
  Prospecting
  Qualification
  Proposal
  Negotiation
  Won
  Lost
}

enum CrmTaskStatus {
  Open
  Done
}

enum WarehouseLocationType {
  Room
  Zone
  Bin
  Dock
  Staging
}

enum CycleCountStatus {
  Draft
  InProgress
  Completed
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  city      String?
  country   String?  @default("India")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                       User[]
  suppliers                   Supplier[]
  warehouses                  Warehouse[]
  containers                  Container[]
  stockItems                  StockItem[]
  stockMovements              StockMovement[]
  gatePasses                  GatePass[]
  gatePassLines               GatePassLine[]
  customers                   Customer[]
  customerContacts            CustomerContact[]
  customerKycDocuments        CustomerKycDocument[]
  priceLists                  PriceList[]
  priceListItems              PriceListItem[]
  salesOrders                 SalesOrder[]
  salesOrderLines             SalesOrderLine[]
  crmLeads                    CrmLead[]
  crmOpportunities            CrmOpportunity[]
  crmTasks                    CrmTask[]
  salesQuotes                 SalesQuote[]
  salesQuoteLines             SalesQuoteLine[]
  salesQuoteRevisions         SalesQuoteRevision[]
  salesOrderRevisions         SalesOrderRevision[]
  warehouseLocations          WarehouseLocation[]
  warehouseCycleCounts        WarehouseCycleCount[]
  warehouseCycleCountLines    WarehouseCycleCountLine[]
  dockAppointments            DockAppointment[]
  warehousePutawayRules       WarehousePutawayRule[]
  repackingWorkOrders         RepackingWorkOrder[]
  qcSamplingPlans             QcSamplingPlan[]
  warehouseProductivityLogs   WarehouseProductivityLog[]
  warehouseExceptionApprovals WarehouseExceptionApproval[]
  supplierClaims              SupplierClaim[]
  customerReceipts            CustomerReceipt[]
  customerReceiptAllocations  CustomerReceiptAllocation[]
  salesInvoices               SalesInvoice[]
  salesInvoiceLines           SalesInvoiceLine[]
  salesReturns                SalesReturn[]
  salesReturnLines            SalesReturnLine[]
  creditNotes                 CreditNote[]
  bankStatementLines          BankStatementLine[]
  journalEntries              JournalEntry[]
  journalEntryLines           JournalEntryLine[]
  financePeriodCloses         FinancePeriodClose[]
  customerDisputes            CustomerDispute[]
  coldRoomReadings            ColdRoomReading[]
  temperatureBreachTasks      TemperatureBreachTask[]
  documentSequences           DocumentSequence[]
  documents                   Document[]
  payments                    Payment[]
  activityLog                 ActivityLog[]
  alertPreferences            UserAlertPreference[]
  alertStates                 UserAlertState[]
  documentAutomationJobs      DocumentAutomationJob[]
  integrationConnections      IntegrationConnection[]
  integrationRuns             IntegrationRun[]
  integrationErrors           IntegrationError[]
  externalReferences          ExternalReference[]
  emailOutbox                 EmailOutbox[]
  fxRates                     FxRate[]
  purchaseOrders              PurchaseOrder[]
  purchaseOrderLines          PurchaseOrderLine[]
  crmActivities               CrmActivity[]
  items                       Item[]
  featureFlags                FeatureFlag[]
  idempotencyKeys             IdempotencyKey[]
  approvalDelegations         ApprovalDelegation[]
  dataDeletionRequests        DataDeletionRequest[]

  @@map("organizations")
}

model User {
  id        String   @id @default(uuid())
  // Supabase auth.users id - links the app profile to the auth identity.
  authId    String?  @unique @map("auth_id")
  orgId     String   @map("org_id")
  email     String   @unique
  fullName  String?  @map("full_name")
  role      Role     @default(viewer)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization              Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  activityLog               ActivityLog[]
  alertPreferences          UserAlertPreference[]
  alertStates               UserAlertState[]
  createdStockMovements     StockMovement[]
  gatePasses                GatePass[]
  assignedCustomers         Customer[]
  reviewedKycDocuments      CustomerKycDocument[]
  publishedPriceLists       PriceList[]
  createdSalesOrders        SalesOrder[]            @relation("SalesOrderCreatedBy")
  updatedSalesOrders        SalesOrder[]            @relation("SalesOrderUpdatedBy")
  reviewedSalesOrders       SalesOrder[]            @relation("SalesOrderReviewedBy")
  createdCustomerReceipts   CustomerReceipt[]       @relation("CustomerReceiptCreatedBy")
  cancelledCustomerReceipts CustomerReceipt[]       @relation("CustomerReceiptCancelledBy")
  createdSalesInvoices      SalesInvoice[]          @relation("SalesInvoiceCreatedBy")
  cancelledSalesInvoices    SalesInvoice[]          @relation("SalesInvoiceCancelledBy")
  createdSalesReturns       SalesReturn[]           @relation("SalesReturnCreatedBy")
  cancelledSalesReturns     SalesReturn[]           @relation("SalesReturnCancelledBy")
  createdCreditNotes        CreditNote[]            @relation("CreditNoteCreatedBy")
  cancelledCreditNotes      CreditNote[]            @relation("CreditNoteCancelledBy")
  uploadedBankLines         BankStatementLine[]     @relation("BankLineUploadedBy")
  matchedBankLines          BankStatementLine[]     @relation("BankLineMatchedBy")
  postedJournalEntries      JournalEntry[]          @relation("JournalEntryPostedBy")
  closedFinancePeriods      FinancePeriodClose[]    @relation("FinancePeriodClosedBy")
  reopenedFinancePeriods    FinancePeriodClose[]    @relation("FinancePeriodReopenedBy")
  createdCustomerDisputes   CustomerDispute[]       @relation("CustomerDisputeCreatedBy")
  reviewedCustomerDisputes  CustomerDispute[]       @relation("CustomerDisputeReviewedBy")
  recordedColdRoomReadings  ColdRoomReading[]       @relation("ColdRoomReadingRecordedBy")
  assignedTemperatureTasks  TemperatureBreachTask[] @relation("TemperatureTaskAssignee")
  resolvedTemperatureTasks  TemperatureBreachTask[] @relation("TemperatureTaskResolvedBy")
  ownedCrmLeads             CrmLead[]               @relation("CrmLeadOwner")
  ownedCrmOpportunities     CrmOpportunity[]        @relation("CrmOpportunityOwner")
  assignedCrmTasks          CrmTask[]               @relation("CrmTaskAssignee")
  ownedCrmActivities        CrmActivity[]

  @@index([orgId])
  @@map("users")
}

model Supplier {
  id             String         @id @default(uuid())
  orgId          String         @map("org_id")
  name           String
  country        String?
  contactName    String?        @map("contact_name")
  email          String?
  phone          String?
  deletedAt      DateTime?      @map("deleted_at")
  deletedById    String?        @map("deleted_by_id")
  deleteReason   String?        @map("delete_reason")
  approvalStatus ApprovalStatus @default(Approved) @map("approval_status")
  pendingChanges Json?          @map("pending_changes")
  requestedById  String?        @map("requested_by_id")
  reviewedById   String?        @map("reviewed_by_id")
  reviewedAt     DateTime?      @map("reviewed_at")
  reviewNotes    String?        @map("review_notes")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  containers     Container[]
  supplierClaims SupplierClaim[]
  purchaseOrders PurchaseOrder[]

  @@index([orgId])
  @@map("suppliers")
}

model Warehouse {
  id              String    @id @default(uuid())
  orgId           String    @map("org_id")
  name            String
  code            String
  city            String
  state           String?
  address         String?
  isActive        Boolean   @default(true) @map("is_active")
  storageType     String?   @map("storage_type")
  isColdStorage   Boolean   @default(true) @map("is_cold_storage")
  temperatureMinC Decimal?  @map("temperature_min_c") @db.Decimal(5, 2)
  temperatureMaxC Decimal?  @map("temperature_max_c") @db.Decimal(5, 2)
  humidityTarget  Decimal?  @map("humidity_target") @db.Decimal(5, 2)
  capacityTonnes  Decimal?  @map("capacity_tonnes") @db.Decimal(10, 2)
  coldRoomCount   Int?      @map("cold_room_count")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization           Organization                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  containers             Container[]
  stockItems             StockItem[]
  gatePasses             GatePass[]
  priceLists             PriceList[]
  salesOrders            SalesOrder[]
  salesQuotes            SalesQuote[]
  salesReturns           SalesReturn[]
  coldRoomReadings       ColdRoomReading[]
  temperatureBreachTasks TemperatureBreachTask[]
  warehouseLocations     WarehouseLocation[]
  warehouseCycleCounts   WarehouseCycleCount[]
  dockAppointments       DockAppointment[]
  warehousePutawayRules  WarehousePutawayRule[]
  repackingWorkOrders    RepackingWorkOrder[]
  qcSamplingPlans        QcSamplingPlan[]
  productivityLogs       WarehouseProductivityLog[]
  exceptionApprovals     WarehouseExceptionApproval[]

  @@unique([orgId, code])
  @@index([orgId])
  @@map("warehouses")
}

model Container {
  id                    String          @id @default(uuid())
  orgId                 String          @map("org_id")
  slNo                  Int?            @map("sl_no")
  // Both identifiers are always present and searchable.
  containerNo           String          @map("container_no")
  blNo                  String          @map("bl_no")
  supplierId            String?         @map("supplier_id")
  warehouseId           String?         @map("warehouse_id")
  customer              String?
  port                  String?
  portCode              String?         @map("port_code")
  item                  String?
  itemId                String?         @map("item_id")
  variety               String?
  noOfBoxes             Int?            @map("no_of_boxes")
  status                ContainerStatus @default(Booked)
  etd                   DateTime?
  eta                   DateTime?
  bookingDate           DateTime?       @map("booking_date")
  // Demurrage / detention free-day deadline. Charges accrue after this date.
  freeDays              Int?            @map("free_days")
  lastFreeDate          DateTime?       @map("last_free_date")
  pol                   String? // Port of Loading
  origin                String? // country of origin
  line                  String? // shipping line
  vessel                String?
  transhipment          String?
  perPackageWeight      Decimal?        @map("per_package_weight") @db.Decimal(10, 3)
  packageType           String?         @map("package_type")
  doUpto                DateTime?       @map("do_upto")
  emptyReturnDate       DateTime?       @map("empty_return_date")
  transitTime           Int?            @map("transit_time")
  ata                   DateTime? // Actual Time of Arrival
  originalEta           DateTime?       @map("original_eta")
  remarks               String?
  flagged               Boolean         @default(false)
  deletedAt             DateTime?       @map("deleted_at")
  warehouseAssignedAt   DateTime?       @map("warehouse_assigned_at")
  warehouseAssignedById String?         @map("warehouse_assigned_by_id")
  warehouseInDate       DateTime?       @map("warehouse_in_date")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  warehouse        Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  itemMaster       Item?             @relation(fields: [itemId], references: [id], onDelete: SetNull)
  shipmentItem     ShipmentItem?
  cost             ContainerCost?
  sale             Sale?
  stockItems       StockItem[]
  gatePasses       GatePass[]
  dockAppointments DockAppointment[]
  supplierClaims   SupplierClaim[]
  purchaseOrders   PurchaseOrder[]
  documents        Document[]
  payments         Payment[]

  @@unique([orgId, containerNo])
  @@index([orgId])
  @@index([containerNo])
  @@index([blNo])
  @@index([status])
  @@index([itemId])
  @@map("containers")
}

model StockItem {
  id                    String             @id @default(uuid())
  orgId                 String             @map("org_id")
  containerId           String             @map("container_id")
  warehouseId           String             @map("warehouse_id")
  locationId            String?            @map("location_id")
  parentStockItemId     String?            @map("parent_stock_item_id")
  item                  String
  itemId                String?            @map("item_id")
  variety               String?
  grade                 String?
  uom                   StockUom
  qtyReceived           Decimal            @map("qty_received") @db.Decimal(14, 3)
  qtyAvailable          Decimal            @map("qty_available") @db.Decimal(14, 3)
  qtyReserved           Decimal            @default(0) @map("qty_reserved") @db.Decimal(14, 3)
  qtySold               Decimal            @default(0) @map("qty_sold") @db.Decimal(14, 3)
  qtyWastage            Decimal            @default(0) @map("qty_wastage") @db.Decimal(14, 3)
  qtyDump               Decimal            @default(0) @map("qty_dump") @db.Decimal(14, 3)
  perUnitWeightKg       Decimal?           @map("per_unit_weight_kg") @db.Decimal(14, 3)
  lotNo                 String?            @map("lot_no")
  palletNo              String?            @map("pallet_no")
  packDate              DateTime?          @map("pack_date")
  expiryDate            DateTime?          @map("expiry_date")
  bestBeforeDate        DateTime?          @map("best_before_date")
  storageCondition      String?            @map("storage_condition")
  ripeningState         String?            @map("ripening_state")
  qualityStatus         StockQualityStatus @default(Released) @map("quality_status")
  temperatureAtReceiptC Decimal?           @map("temperature_at_receipt_c") @db.Decimal(5, 2)
  temperatureBreach     Boolean            @default(false) @map("temperature_breach")
  qualityHoldReason     String?            @map("quality_hold_reason")
  qualityReviewedAt     DateTime?          @map("quality_reviewed_at")
  qualityReviewedById   String?            @map("quality_reviewed_by_id")
  deletedAt             DateTime?          @map("deleted_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  organization             Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  container                Container                 @relation(fields: [containerId], references: [id], onDelete: Cascade)
  warehouse                Warehouse                 @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  itemMaster               Item?                     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  location                 WarehouseLocation?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  parentStockItem          StockItem?                @relation("StockLotSplit", fields: [parentStockItemId], references: [id], onDelete: SetNull)
  childStockItems          StockItem[]               @relation("StockLotSplit")
  movements                StockMovement[]
  gatePasses               GatePass[]
  gatePassLines            GatePassLine[]
  salesOrderLines          SalesOrderLine[]
  salesQuoteLines          SalesQuoteLine[]
  salesInvoiceLines        SalesInvoiceLine[]
  salesReturnLines         SalesReturnLine[]
  warehouseCycleCountLines WarehouseCycleCountLine[]
  repackingWorkOrders      RepackingWorkOrder[]
  qcSamplingPlans          QcSamplingPlan[]
  supplierClaims           SupplierClaim[]

  @@index([orgId])
  @@index([warehouseId])
  @@index([containerId])
  @@index([parentStockItemId])
  @@index([item, grade, warehouseId])
  @@index([itemId])
  @@map("stock_items")
}

model StockMovement {
  id          String            @id @default(uuid())
  orgId       String            @map("org_id")
  stockItemId String            @map("stock_item_id")
  kind        StockMovementKind
  qty         Decimal           @db.Decimal(14, 3)
  uom         StockUom
  reason      String?
  refType     String?           @map("ref_type")
  refId       String?           @map("ref_id")
  createdById String?           @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stockItem    StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([stockItemId])
  @@index([kind])
  @@map("stock_movements")
}

model GatePass {
  id                    String         @id @default(uuid())
  orgId                 String         @map("org_id")
  warehouseId           String         @map("warehouse_id")
  salesOrderId          String?        @map("sales_order_id")
  stockItemId           String?        @map("stock_item_id")
  containerId           String?        @map("container_id")
  gatePassNo            String         @map("gate_pass_no")
  vehicleNo             String?        @map("vehicle_no")
  driverName            String?        @map("driver_name")
  driverContact         String?        @map("driver_contact")
  vehicleSealNo         String?        @map("vehicle_seal_no")
  loadingPhotoRef       String?        @map("loading_photo_ref")
  securityOtp           String?        @map("security_otp")
  securityGateOutAt     DateTime?      @map("security_gate_out_at")
  podRef                String?        @map("pod_ref")
  podAcknowledgedBy     String?        @map("pod_acknowledged_by")
  podAcknowledgedAt     DateTime?      @map("pod_acknowledged_at")
  routeName             String?        @map("route_name")
  beatName              String?        @map("beat_name")
  deliveryInstructions  String?        @map("delivery_instructions")
  returnCratesPlanned   Int            @default(0) @map("return_crates_planned")
  returnCratesReceived  Int            @default(0) @map("return_crates_received")
  returnPalletsPlanned  Int            @default(0) @map("return_pallets_planned")
  returnPalletsReceived Int            @default(0) @map("return_pallets_received")
  notes                 String?
  exceptionReason       String?        @map("exception_reason")
  status                GatePassStatus @default(Picked)
  pickedAt              DateTime?      @map("picked_at")
  packedAt              DateTime?      @map("packed_at")
  readyAt               DateTime?      @map("ready_at")
  dispatchedAt          DateTime?      @map("dispatched_at")
  createdById           String?        @map("created_by_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  salesOrder   SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  stockItem    StockItem?     @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  container    Container?     @relation(fields: [containerId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines        GatePassLine[]

  @@unique([orgId, gatePassNo])
  @@index([orgId])
  @@index([warehouseId])
  @@index([status])
  @@index([containerId])
  @@map("gate_passes")
}

model GatePassLine {
  id            String   @id @default(uuid())
  orgId         String   @map("org_id")
  gatePassId    String   @map("gate_pass_id")
  stockItemId   String   @map("stock_item_id")
  qtyPlanned    Decimal  @map("qty_planned") @db.Decimal(14, 3)
  qtyDispatched Decimal  @default(0) @map("qty_dispatched") @db.Decimal(14, 3)
  uom           StockUom
  createdAt     DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  gatePass     GatePass     @relation(fields: [gatePassId], references: [id], onDelete: Cascade)
  stockItem    StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([gatePassId])
  @@index([stockItemId])
  @@map("gate_pass_lines")
}

model Customer {
  id                   String            @id @default(uuid())
  orgId                String            @map("org_id")
  code                 String
  name                 String
  tradeName            String?           @map("trade_name")
  gstin                String?
  pan                  String?
  email                String?
  phone                String?
  billingAddress       String?           @map("billing_address")
  shippingAddress      String?           @map("shipping_address")
  deliveryInstructions String?           @map("delivery_instructions")
  city                 String?
  state                String?
  region               String?
  assignedRepId        String?           @map("assigned_rep_id")
  creditLimit          Decimal?          @map("credit_limit") @db.Decimal(14, 2)
  creditHold           Boolean           @default(false) @map("credit_hold")
  customerTier         String?           @map("customer_tier")
  paymentTermsDays     Int               @default(0) @map("payment_terms_days")
  creditReviewDate     DateTime?         @map("credit_review_date")
  kycStatus            CustomerKycStatus @default(Pending) @map("kyc_status")
  approvalStatus       ApprovalStatus    @default(PendingApproval) @map("approval_status")
  pendingChanges       Json?             @map("pending_changes")
  requestedById        String?           @map("requested_by_id")
  reviewedById         String?           @map("reviewed_by_id")
  reviewedAt           DateTime?         @map("reviewed_at")
  reviewNotes          String?           @map("review_notes")
  notes                String?
  deletedAt            DateTime?         @map("deleted_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  organization       Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignedRep        User?                 @relation(fields: [assignedRepId], references: [id], onDelete: SetNull)
  contacts           CustomerContact[]
  kycDocuments       CustomerKycDocument[]
  salesOrders        SalesOrder[]
  salesQuotes        SalesQuote[]
  customerReceipts   CustomerReceipt[]
  salesInvoices      SalesInvoice[]
  salesReturns       SalesReturn[]
  creditNotes        CreditNote[]
  bankStatementLines BankStatementLine[]
  customerDisputes   CustomerDispute[]
  crmLeads           CrmLead[]
  crmOpportunities   CrmOpportunity[]
  crmTasks           CrmTask[]
  crmActivities      CrmActivity[]

  @@unique([orgId, code])
  @@index([orgId])
  @@index([assignedRepId])
  @@index([region])
  @@map("customers")
}

model CustomerContact {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  customerId  String   @map("customer_id")
  name        String
  designation String?
  phone       String?
  email       String?
  isPrimary   Boolean  @default(false) @map("is_primary")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
