model CustomerDispute {
  id              String                @id @default(uuid())
  orgId           String                @map("org_id")
  disputeNo       String                @map("dispute_no")
  customerId      String                @map("customer_id")
  salesInvoiceId  String?               @map("sales_invoice_id")
  salesReturnId   String?               @map("sales_return_id")
  creditNoteId    String?               @map("credit_note_id")
  status          CustomerDisputeStatus @default(Open)
  priority        String                @default("Normal")
  reason          String
  claimAmount     Decimal?              @map("claim_amount") @db.Decimal(14, 2)
  approvedAmount  Decimal?              @map("approved_amount") @db.Decimal(14, 2)
  resolutionNotes String?               @map("resolution_notes")
  createdById     String?               @map("created_by_id")
  reviewedById    String?               @map("reviewed_by_id")
  reviewedAt      DateTime?             @map("reviewed_at")
  resolvedAt      DateTime?             @map("resolved_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesInvoice SalesInvoice? @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  salesReturn  SalesReturn?  @relation(fields: [salesReturnId], references: [id], onDelete: SetNull)
  creditNote   CreditNote?   @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("CustomerDisputeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy   User?         @relation("CustomerDisputeReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([orgId, disputeNo])
  @@index([orgId])
  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@map("customer_disputes")
}

model ColdRoomReading {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  warehouseId  String   @map("warehouse_id")
  locationId   String?  @map("location_id")
  recordedAt   DateTime @map("recorded_at")
  temperatureC Decimal  @map("temperature_c") @db.Decimal(5, 2)
  humidityPct  Decimal? @map("humidity_pct") @db.Decimal(5, 2)
  source       String   @default("Manual")
  notes        String?
  recordedById String?  @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  warehouse    Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location     WarehouseLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  recordedBy   User?                   @relation("ColdRoomReadingRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  breachTasks  TemperatureBreachTask[]

  @@index([orgId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([recordedAt])
  @@map("cold_room_readings")
}

model TemperatureBreachTask {
  id              String                      @id @default(uuid())
  orgId           String                      @map("org_id")
  taskNo          String                      @map("task_no")
  warehouseId     String                      @map("warehouse_id")
  locationId      String?                     @map("location_id")
  readingId       String?                     @map("reading_id")
  severity        TemperatureBreachSeverity   @default(Warning)
  status          TemperatureBreachTaskStatus @default(Open)
  title           String
  description     String?
  targetMinC      Decimal?                    @map("target_min_c") @db.Decimal(5, 2)
  targetMaxC      Decimal?                    @map("target_max_c") @db.Decimal(5, 2)
  actualTempC     Decimal?                    @map("actual_temp_c") @db.Decimal(5, 2)
  assignedToId    String?                     @map("assigned_to_id")
  acknowledgedAt  DateTime?                   @map("acknowledged_at")
  resolvedAt      DateTime?                   @map("resolved_at")
  resolvedById    String?                     @map("resolved_by_id")
  resolutionNotes String?                     @map("resolution_notes")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location     WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  reading      ColdRoomReading?   @relation(fields: [readingId], references: [id], onDelete: SetNull)
  assignedTo   User?              @relation("TemperatureTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy   User?              @relation("TemperatureTaskResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([orgId, taskNo])
  @@index([orgId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([status])
  @@index([severity])
  @@map("temperature_breach_tasks")
}

model SalesOrderLine {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  salesOrderId    String   @map("sales_order_id")
  stockItemId     String   @map("stock_item_id")
  priceListItemId String?  @map("price_list_item_id")
  lineNo          Int      @map("line_no")
  item            String
  variety         String?
  grade           String?
  uom             StockUom
  qty             Decimal  @db.Decimal(14, 3)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(14, 2)
  floorPrice      Decimal  @map("floor_price") @db.Decimal(14, 2)
  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(14, 2)
  lineTotal       Decimal  @map("line_total") @db.Decimal(14, 2)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization  Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  salesOrder    SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  stockItem     StockItem          @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  priceListItem PriceListItem?     @relation(fields: [priceListItemId], references: [id], onDelete: SetNull)
  invoiceLines  SalesInvoiceLine[]
  returnLines   SalesReturnLine[]

  @@unique([salesOrderId, lineNo])
  @@index([orgId])
  @@index([salesOrderId])
  @@index([stockItemId])
  @@index([priceListItemId])
  @@index([item, grade, uom])
  @@map("sales_order_lines")
}

model ShipmentItem {
  id              String    @id @default(uuid())
  orgId           String    @map("org_id")
  containerId     String    @unique @map("container_id")
  invoiceNo       String?   @map("invoice_no")
  packingListNo   String?   @map("packing_list_no")
  invoiceDate     DateTime? @map("invoice_date")
  invoiceValue    Decimal?  @map("invoice_value") @db.Decimal(14, 2)
  invoiceCurrency Currency  @default(USD) @map("invoice_currency")
  beNo            String?   @map("be_no")
  beDate          DateTime? @map("be_date")
  hsCode          String?   @map("hs_code")
  netWeightKg     Decimal?  @map("net_weight_kg") @db.Decimal(12, 2)
  grossWeightKg   Decimal?  @map("gross_weight_kg") @db.Decimal(12, 2)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  container Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("shipment_items")
}

model ContainerCost {
  id                String    @id @default(uuid())
  orgId             String    @map("org_id")
  containerId       String    @unique @map("container_id")
  // All local costs in INR.
  beInvoiceValueInr Decimal?  @map("be_invoice_value_inr") @db.Decimal(14, 2)
  exchangeRate      Decimal?  @map("exchange_rate") @db.Decimal(12, 4)
  customsDuty       Decimal?  @map("customs_duty") @db.Decimal(14, 2)
  clearingCharges   Decimal?  @map("clearing_charges") @db.Decimal(14, 2)
  linerCharges      Decimal?  @map("liner_charges") @db.Decimal(14, 2)
  detention         Decimal?  @db.Decimal(14, 2)
  chaCharges        Decimal?  @map("cha_charges") @db.Decimal(14, 2)
  igst              Decimal?  @db.Decimal(14, 2)
  cess              Decimal?  @db.Decimal(14, 2)
  transport         Decimal?  @db.Decimal(14, 2)
  ohProportion      Decimal?  @map("oh_proportion") @db.Decimal(14, 2)
  claimDeduction    Decimal?  @map("claim_deduction") @db.Decimal(14, 2)
  otherCharges      Decimal?  @map("other_charges") @db.Decimal(14, 2)
  // Cached computed values (recomputed by the finance engine on write).
  totalCost         Decimal?  @map("total_cost") @db.Decimal(14, 2)
  ratePerBoxLanding Decimal?  @map("rate_per_box_landing") @db.Decimal(14, 2)
  ratePerBox        Decimal?  @map("rate_per_box") @db.Decimal(14, 2)
  // Maker-checker: a finalized cost sheet is locked from further edits.
  finalized         Boolean   @default(false)
  finalizedAt       DateTime? @map("finalized_at")
  finalizedById     String?   @map("finalized_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  container Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("container_costs")
}

model Sale {
  id             String         @id @default(uuid())
  orgId          String         @map("org_id")
  containerId    String         @unique @map("container_id")
  soldQty        Int?           @map("sold_qty")
  avgPrice       Decimal?       @map("avg_price") @db.Decimal(14, 2)
  saleValue      Decimal?       @map("sale_value") @db.Decimal(14, 2)
  damageQty      Int?           @map("damage_qty")
  damageValue    Decimal?       @map("damage_value") @db.Decimal(14, 2)
  // Cached computed values.
  profit         Decimal?       @db.Decimal(14, 2)
  profitPerBox   Decimal?       @map("profit_per_box") @db.Decimal(14, 2)
  marginPct      Decimal?       @map("margin_pct") @db.Decimal(6, 2)
  // Review gate: imported or edited sales are not operational until approved.
  approvalStatus ApprovalStatus @default(PendingApproval) @map("approval_status")
  reviewedById   String?        @map("reviewed_by_id")
  reviewedAt     DateTime?      @map("reviewed_at")
  reviewNotes    String?        @map("review_notes")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  container Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("sales")
}

model Payment {
  id              String         @id @default(uuid())
  orgId           String         @map("org_id")
  containerId     String         @map("container_id")
  supplierName    String?        @map("supplier_name")
  amountRequested Decimal        @map("amount_requested") @db.Decimal(14, 2)
  amountPaid      Decimal        @default(0) @map("amount_paid") @db.Decimal(14, 2)
  currency        Currency       @default(USD)
  requestDate     DateTime?      @map("request_date")
  dueDate         DateTime?      @map("due_date")
  paidDate        DateTime?      @map("paid_date")
  status          PaymentStatus  @default(Pending)
  // Maker-checker approval: maker raises the request, a different checker approves.
  approvalStatus  ApprovalStatus @default(PendingApproval) @map("approval_status")
  requestedById   String?        @map("requested_by_id")
  approvedById    String?        @map("approved_by_id")
  approvedAt      DateTime?      @map("approved_at")
  reference       String?
  notes           String?
  deletedAt       DateTime?      @map("deleted_at")
  deletedById     String?        @map("deleted_by_id")
  deleteReason    String?        @map("delete_reason")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  container    Container    @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([containerId])
  @@index([status])
  @@map("payments")
}

model Document {
  id           String         @id @default(uuid())
  orgId        String         @map("org_id")
  containerId  String         @map("container_id")
  type         DocumentType
  docNo        String?        @map("doc_no")
  // Denormalised for fast filtering - kept in sync with the container.
  containerNo  String?        @map("container_no")
  blNo         String?        @map("bl_no")
  supplierName String?        @map("supplier_name")
  issueDate    DateTime?      @map("issue_date")
  expiryDate   DateTime?      @map("expiry_date")
  status       DocumentStatus @default(Pending)
  fileUrl      String?        @map("file_url")
  filePath     String?        @map("file_path")
  fileName     String?        @map("file_name")
  fileSize     Int?           @map("file_size")
  deletedAt    DateTime?      @map("deleted_at")
  deletedById  String?        @map("deleted_by_id")
  deleteReason String?        @map("delete_reason")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  container    Container    @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([containerId])
  @@index([type])
  @@index([expiryDate])
  @@map("documents")
}

model ActivityLog {
  id         String   @id @default(uuid())
